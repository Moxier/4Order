# Public values are safe for the browser. Use values from `supabase status` for
# local development or the Supabase project's Connect dialog in production.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key

# Server-only. Required by the development staff seeder and the narrow Phase 2
# customer-order endpoint. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key

# Development-only password used by `pnpm seed:staff`. The script refuses to
# run against a non-local Supabase URL unless explicitly overridden.
DEMO_STAFF_PASSWORD=change-me-for-local-development

# Forwarded host/protocol headers are ignored by default. Enable this only when
# the application runs behind a trusted ingress that overwrites both headers,
# then list every exact public origin (scheme, hostname, and optional port).
TRUST_PROXY_HEADERS=false
TRUSTED_APP_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
